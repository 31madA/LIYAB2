:false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":356,"indent":0,"parameters":["LIYAB SetChapter 2"]},{"code":356,"indent":0,"parameters":["MSGSE TALK 1"]},{"code":241,"indent":0,"parameters":[{"name":"Theme2","volume":75,"pitch":100,"pan":0}]},{"code":222,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[30]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["(Interior of the municipal building. A wooden desk covered in papers, a map of Cavite pinned to the wall with charcoal markings. Oil lamp light. The town is on edge.)"]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":205,"indent":0,"parameters":[2,{"list":[{"code":1,"indent":null,"parameters":[]}],"repeat":false,"skippable":false,"wait":true},false]},{"code":230,"indent":0,"parameters":[15]},{"code":401,"indent":0,"parameters":["(Mariano Trias sits behind the desk. Not a large man, but his presence fills the room. Clean-shaven, neatly dressed despite the chaos outside. He looks at the two mud-caked travelers.)"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Trias> Tell me why I should not have you imprisoned."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Florante> (carefully controlled) Why would you imprison us? We have done nothing wrong."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Trias> Two men with no connections in Cavite, emerging from the forest, carrying bolos, claiming to come from Bonifacio's defeat. You could be Spanish spies."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Florante> If we were spies, why would we go to your checkpoint?"]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["(A thin smile crosses Trias's face. It is not warm.)"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Trias> Correct. If you were spies, you would have acted with more intelligence. And I do not think — you are fools."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Trias> Tell me. What happened in Manila?"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Florante> We gathered at Hagdang Bato. Bonifacio read the Manifesto. Then we marched to San Juan to take El Polvorin. The assault... failed. We ran out of ammunition before we could reach the powder. The Spanish arrived with artillery. The men scattered."]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["(Trias nods slowly. He does not look surprised. He stands and walks to the map, tracing a line from Manila south to Cavite.)"]},{"code":205,"indent":0,"parameters":[2,{"list":[{"code":3,"indent":null,"parameters":[]},{"code":3,"indent":null,"parameters":[]},{"code":3,"indent":null,"parameters":[]}],"repeat":false,"skippable":false,"wait":true},false]},{"code":230,"indent":0,"parameters":[30]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Trias> The fighting here in Cavite is different from Manila. In Manila, the Spanish have fortifications and soldiers. Here, they are few and scattered. But the tribunal of San Francisco de Malabon — the Spanish are still there. They are hiding inside, waiting for reinforcements. We cannot leave them there."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Trias> In the tribunal: twenty Guardia Civil, three officers, and several colonial government employees. They have enough food for a week. When is the assault? — Tonight."]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["(He moves to a trunk in the corner and opens it. Inside: several old rifles, a few boxes of ammunition, a Spanish officer's sword.)"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Trias> Choose. We do not have many weapons — we must make each one count."]},{"code":102,"indent":0,"parameters":[["Take the rifle","Take the officer's sword"],1,0,1,0]},{"code":402,"indent":0,"parameters":[0,"Take the rifle"]},{"code":101,"indent":1,"parameters":["girl",0,0,2]},{"code":401,"indent":1,"parameters":["\\n<Sandra> (You take the rifle. It is heavier than it looks.)"]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[1,"Take the officer's sword"]},{"code":101,"indent":1,"parameters":["girl",0,0,2]},{"code":401,"indent":1,"parameters":["\\n<Sandra> (You take the Spanish officer's sword. The hilt is worn smooth.)"]},{"code":0,"indent":1,"parameters":[]},{"code":403,"indent":0,"parameters":[0]},{"code":0,"indent":1,"parameters":[]},{"code":404,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Florante> (he picks a rifle, checking its action with practiced hands)"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Trias> Listen carefully. Here is the plan. The diversion — that is the work of our other companions. You, with me, will enter through the rear — where the wall is weakened by age and weather. Inside, we split up — we find the officers and take them prisoner. If they fight — we finish them."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Trias> In Cavite, loyalty is not automatic. It must be proven. This battle tonight is your first chance."]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["(The audience is over. Men are moving with purpose in the street — checking rifles, sharpening bolos, loading cartridges with precious gunpowder.)"]},{"code":250,"indent":0,"parameters":[{"name":"Decision2","volume":75,"pitch":60,"pan":0}]},{"code":230,"indent":0,"parameters":[20]},{"code":121,"indent":0,"parameters":[20,20,0]},{"code":123,"indent":0,"parameters":["A",0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"indent":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}]},{"id":2,"name":"Trias","x":13,"y":10,"note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":20,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"%npc-commonerman3","direction":2,"pattern":0,"tileId":0},"list":[{"code":356,"indent":0,"parameters":["MSGSE TALK 1"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Trias> Tonight we take the tribunal. Rest your hands while you can."]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"indent":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}]},{"id":3,"name":"Florante","x":16,"y":10,"note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":20,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"%npc-arnis-2","direction":2,"pattern":0,"tileId":0},"list":[{"code":356,"indent":0,"parameters":["MSGSE TALK 1"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Florante> A rifle. A wall. A signal shot. Simple enough. Let us be done with it."]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"indent":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}]},{"id":4,"name":"Guard","x":14,"y":12,"note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":20,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"%npc-commonerman5","direction":2,"pattern":0,"tileId":0},"list":[{"code":356,"indent":0,"parameters":["MSGSE TALK 1"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Guard> The wall on the rear is old. One good hit and it gives. That is our way in."]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"indent":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}]},{"name":"S7 Tribunal Assault","x":15,"y":16,"note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":20,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":356,"indent":0,"parameters":["MSGSE TALK 1"]},{"code":223,"indent":0,"parameters":[[-130,-130,0,85],60,true]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["(Night. The tribunal is a dark block against the sky — two stories, iron-barred windows, a heavy wooden door at the front. Trias crouches behind a low wall with the men, fifty meters from the tribunal's rear.)"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Trias> (low, to the men around him) Wait for the signal. When you hear the first shot at the front — that is the sign. You follow me. Do not go ahead — do not fall behind."]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["(Minutes pass. A dog barks somewhere in the town. Then — A GUNSHOT. Front gate. Shouting. The diversion.)"]},{"code":250,"indent":0,"parameters":[{"name":"Gun1","volume":90,"pitch":100,"pan":0}]},{"code":230,"indent":0,"parameters":[20]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Trias> (rising) Now!"]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["(They sprint across open ground to the rear wall. The stone is old, weakened by weather. Two men with a wooden ram strike it once, twice. On the third blow, the wall cracks inward.)"]},{"code":250,"indent":0,"parameters":[{"name":"Crash","volume":90,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Trias> (through the breach) Inside! Do not stop until we are in!"]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["(COMBAT — the breach and the tribunal interior. Overturned furniture, a Spanish officer fumbling for his pistol, a Guardia Civil lunging with a bayonet. Florante meets the bayonet with his rifle butt — a sharp crack of wood on bone.)"]},{"code":221,"indent":0,"parameters":[]},{"code":301,"indent":0,"parameters":[11,11,0,0]},{"code":601,"indent":0,"parameters":[0]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["(In a narrow hallway, a Spanish officer levels a revolver at Trias's back. You see it just before he does.)"]},{"code":101,"indent":1,"parameters":["girl",0,0,2]},{"code":401,"indent":1,"parameters":["\\n<Sandra> TRIAS — DUCK!"]},{"code":250,"indent":1,"parameters":[{"name":"Gun1","volume":80,"pitch":100,"pan":0}]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["(Trias drops. The revolver fires — the shot goes over his head, chipping stone from the wall. You lunge — bolo meets wrist. The officer screams. The revolver clatters to the floor.)"]},{"code":250,"indent":1,"parameters":[{"name":"Sword1","volume":90,"pitch":100,"pan":0}]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["\\n<Trias> (brief, direct) Good."]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["(Minutes later. The tribunal is secured. The front gate has fallen. The Spanish defenders have either surrendered or fled into the night. Diego Mojica directs men to round up prisoners. Nicolas Portilla emerges from the armory, his arms full of captured rifles.)"]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["(Florante appears at your side, a Guardia helmet balanced absurdly on his head. He takes it off, looks at it, tosses it aside.)"]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["\\n<Florante> (breathing hard, almost smiling) So this is what winning feels like."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["\\n<Trias> Tomorrow, there is more work. Tonight — rest. You have earned it."]},{"code":221,"indent":1,"parameters":[]},{"code":230,"indent":1,"parameters":[30]},{"code":223,"indent":1,"parameters":[[0,0,0,0],120,true]},{"code":222,"indent":1,"parameters":[]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["(Morning. The sun is up. Families emerge from their houses, children run through the streets, women carry food to the Katipuneros standing guard at every corner.)"]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["(A commotion at the gate — a MESSENGER, exhausted and dusty, pushes past the guards toward Trias.)"]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["\\n<Messenger> Commander — news from outside! A general named Llanera in Nueva Ecija has also risen — they attacked San Isidro. And Tandang Sora... she has been deported to Guam. With her are one hundred and seventy-one other prisoners. They say she was double-chained when they put her on the ship."]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["(The name lands. You feel it in your chest. Florante sets down his rifle.)"]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["\\n<Trias> (quietly) That is the price of resistance."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["\\n<Messenger> And third, commander... four of our brothers were shot at Luneta — at Bagumbayan. Sancho Valenzuela... Ramon Peralta... Modesto Rivera... and Eugenio Silvestre."]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["(Each name sits in the air. The courtyard goes quiet.)"]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["\\n<Florante> (standing, his voice rough) This does not end with one battle, does it?"]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["\\n<Trias> (to you and Florante, lower now) Yesterday you were two men with no name here in Cavite. Today — you are known. Do not waste it."]},{"code":250,"indent":1,"parameters":[{"name":"Decision2","volume":75,"pitch":60,"pan":0}]},{"code":230,"indent":1,"parameters":[20]},{"code":121,"indent":1,"parameters":[21,21,0]},{"code":121,"indent":1,"parameters":[22,22,0]},{"code":123,"indent":1,"parameters":["A",0]},{"code":0,"indent":1,"parameters":[]},{"code":604,"indent":0,"parameters":[0]},{"code":0,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"indent":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":1,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"id":5},{"id":6,"name":"Trias After Assault","x":13,"y":10,"note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":21,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"%npc-commonerman3","direction":2,"pattern":0,"tileId":0},"list":[{"code":356,"indent":0,"parameters":["MSGSE TALK 1"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Trias> The tribunal is ours. But the war is only beginning. Rest today — tomorrow the towns will hear of this."]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"indent":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}]},{"id":7,"name":"Florante After Assault","x":16,"y":10,"note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":21,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"%npc-arnis-2","direction":2,"pattern":0,"tileId":0},"list":[{"code":356,"indent":0,"parameters":["MSGSE TALK 1"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Florante> We won. But Tandang Sora is on a ship to Guam, and four brothers lie at Bagumbayan. Winning does not feel the way I thought it would."]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"indent":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}]},{"id":8,"name":"Road Ahead","x":15,"y":20,"note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":21,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":356,"indent":0,"parameters":["MSGSE TALK 1"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Florante> There is more to come. We will hear of Imus, and of battles by the sea. For now — we stay with Trias."]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["(The rest of Chapter 2 continues here — Imus, Binakayan, and beyond. Maps and events pending.)"]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"indent":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}]}]}