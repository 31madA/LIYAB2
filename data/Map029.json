... We lost. It's over. It's over."]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["(Florante stops. He crouches in front of him.)"]},{"code":205,"indent":0,"parameters":[5,{"list":[{"code":3,"indent":null,"parameters":[]}],"repeat":false,"skippable":false,"wait":true},false]},{"code":230,"indent":0,"parameters":[15]},{"code":205,"indent":0,"parameters":[4,{"list":[{"code":4,"indent":null,"parameters":[]},{"code":3,"indent":null,"parameters":[]},{"code":3,"indent":null,"parameters":[]}],"repeat":false,"skippable":false,"wait":true},false]},{"code":230,"indent":0,"parameters":[30]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Florante> Don't speak that way. You are still alive. While you are alive — there is still a fight."]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["(The wounded man looks at him. Florante helps him to his feet. They move on together — three instead of two.)"]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["(The three reach a crossroads. The wounded man points east toward Mariquina — where Bonifacio retreated. Florante looks at the southern road.)"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Florante> If we go with him, we go back to where we just fled. The Spanish will pursue Bonifacio — they know he is the leader."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Florante> We would be more useful alive and fighting elsewhere."]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["(The wounded man understands. He clasps Florante's arm — the Katipunan salute — and limps east.)"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Wounded Katipunero> Be careful. You will hear many stories on the road — not all of them are true. Choose carefully what you believe."]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["(Florante turns south. You follow.)"]},{"code":101,"indent":0,"parameters":["girl",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Sandra> (internal) South. Toward Cavite."]},{"code":250,"indent":0,"parameters":[{"name":"Decision2","volume":75,"pitch":60,"pan":0}]},{"code":230,"indent":0,"parameters":[20]},{"code":121,"indent":0,"parameters":[15,15,0]},{"code":123,"indent":0,"parameters":["A",0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"indent":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}]},{"id":4,"name":"Wounded Katipunero","x":6,"y":9,"note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":15,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"%npc-commonerman5","direction":2,"pattern":0,"tileId":0},"list":[{"code":356,"indent":0,"parameters":["MSGSE TALK 1"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Wounded Katipunero> Go south, friend. Do not let what happened today end the fight."]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"indent":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}]},{"id":5,"name":"Florante","x":4,"y":10,"note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":15,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"%npc-arnis-2","direction":2,"pattern":0,"tileId":0},"list":[{"code":356,"indent":0,"parameters":["MSGSE TALK 1"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Florante> Bonifacio will rally the north. The south is ours to see."]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"indent":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}]},{"id":6,"name":"Exit South","x":6,"y":11,"note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":15,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":221,"indent":0,"parameters":[]},{"code":201,"indent":0,"parameters":[0,30,5,13,8,2]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"indent":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":1,"walkAnime":true}]}]}